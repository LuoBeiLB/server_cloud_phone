# 复制为 .env 后按需修改（前缀 CLOUD_）
# 设备后端：simulator（任意平台，demo）｜ redroid（Linux + Docker）
CLOUD_DEVICE_BACKEND=simulator

# 数据库：dev 用 SQLite；生产改 Postgres
# CLOUD_DATABASE_URL=postgresql+asyncpg://cloud:cloud@localhost:5432/cloud
CLOUD_DATABASE_URL=sqlite+aiosqlite:///./cloud_platform.db

# JWT
CLOUD_JWT_SECRET=change-me-in-production-please
CLOUD_JWT_EXPIRE_MINUTES=720

# 初始管理员
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=admin123

# Redroid（CLOUD_DEVICE_BACKEND=redroid 时生效）
CLOUD_REDROID_IMAGE=redroid/redroid:12.0.0_64only-latest
CLOUD_REDROID_DATA_DIR=/data/redroid
CLOUD_REDROID_GPU_MODE=guest

# 代理池（一机一码独立出口 IP），JSON 数组
# CLOUD_PROXY_POOL=["socks5://1.2.3.4:1080","http://5.6.7.8:8080"]
