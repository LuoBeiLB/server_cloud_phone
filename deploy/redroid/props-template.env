# 一机一码 · Redroid 每实例属性模板（props template）
# ---------------------------------------------------------------------------
# 用途：平台「一机一码」为每台云手机生成互不相同的设备标识 + 分辨率，
#       这些值以 Redroid 启动参数（ro.* / androidboot.*）注入容器。
#
# 对齐后端：backend/app/fingerprint.py -> redroid_props() 注入的正是下列字段；
#          RedroidBackend 另外注入 androidboot.redroid_gpu_mode。
#
# 用法：
#   1) 复制为具体实例的 env 文件：cp props-template.env inst0.env
#   2) 按实例改值（尤其 SERIALNO / ANDROID_ID 必须每台不同，才算「一机一码」）
#   3) start-instance.sh 会 `source` 该文件（也可用命令行 flag 覆盖）
# ---------------------------------------------------------------------------

# --- 实例编号与端口（host 5555+ID 对齐后端 redroid_base_adb_port=5555 + device.id）---
DEVICE_ID=0                     # 实例序号；后端里等于 device.id
ADB_PORT=5555                   # 宿主 adb 端口 = 5555 + DEVICE_ID，见 start-instance.sh 计算
DATA_DIR=/data/redroid/inst0    # 该实例的 /data 持久化目录（与后端 CLOUD_REDROID_DATA_DIR 对齐）

# --- 设备标识（会注入为 ro.product.* / ro.serialno / androidboot.serialno）---
MODEL="Pixel 6"                 # ro.product.model
BRAND="google"                  # ro.product.brand
MANUFACTURER="Google"           # ro.product.manufacturer
PRODUCT_NAME="Pixel 6"          # ro.product.name
# 序列号：每台必须不同。留空则 start-instance.sh 用 openssl 随机生成 SNxxxxxxxx
SERIALNO=""                     # ro.serialno / androidboot.serialno
# Android 唯一标识（settings secure android_id）；prop 无法直接改，
# 由平台启动后 `adb shell settings put secure android_id <值>` 写入，此处仅登记
ANDROID_ID=""

# --- 屏幕（注入为 androidboot.redroid_width/height/dpi）---
WIDTH=720                       # 宽（px）
HEIGHT=1280                     # 高（px）
DPI=320                         # 像素密度

# --- 渲染（注入为 androidboot.redroid_gpu_mode）---
# host  = 宿主 GPU 硬件加速（Intel/AMD 核显，需 --device /dev/dri）
# guest = 软件渲染（NVIDIA 或无 render node 时使用，最稳）
GPU_MODE=guest

# --- 网络 / 出口 IP（一机一码独立出口）---
# 每实例独立代理位；start-instance.sh 会注入为容器内 HTTP_PROXY/HTTPS_PROXY
# 形如 socks5://1.2.3.4:1080 或 http://5.6.7.8:8080，留空表示直连
PROXY=""

# --- 镜像 ---
REDROID_IMAGE="redroid/redroid:12.0.0_64only-latest"

# 备注：
# - IMEI：redroid 默认无 telephony，靠 prop 改不彻底，深度改机需 Magisk/LSPosed 模块（见 PoC D9）。
# - MAC：同理，网卡 MAC 深度伪造需模块支持，demo 阶段以 model/serialno/android_id 区分即可。
